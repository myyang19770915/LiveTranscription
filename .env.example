APP_PORT=18082
GPU_MEMORY_UTILIZATION=0.40
ASR_MAX_MODEL_LEN=16384
CUDA_VISIBLE_DEVICES=0
ASR_MODEL_PATH=netease-youdao/Confucius4-R2T2
ASR_SECRET_KEY=replace-with-a-long-random-secret
TRANSLATE_MODEL_REPO=google/gemma-4-E2B-it-qat-q4_0-gguf
TRANSLATE_MODEL_FILE=gemma-4-E2B_q4_0-it.gguf

# 會議資料庫（必填，請換成長的隨機字串）
POSTGRES_PASSWORD=replace-with-a-long-random-secret
# 系統管理員的 LDAP 帳號，逗號分隔；只有他們能建立團隊、管理成員
ADMIN_USERS=
# 公司 LDAP。搜尋後綁定：填 LDAP_BIND_DN／LDAP_BIND_PASSWORD 服務帳號與 LDAP_BASE_DN、LDAP_USER_FILTER；
# 沒有服務帳號時改填 LDAP_USER_DN_TEMPLATE，例如 uid={username},ou=people,dc=example,dc=com
LDAP_URL=ldaps://ldap.example.com
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_USER_DN_TEMPLATE=
LDAP_DISPLAY_ATTR=displayName
# 容器內可讀到的 CA 憑證路徑（ldaps 使用自簽 CA 時）
LDAP_CA_FILE=
# 以 HTTPS 反向代理對外時：代理的 IP，以及強制登入 cookie 只走 HTTPS
FORWARDED_ALLOW_IPS=127.0.0.1
SESSION_COOKIE_SECURE=
# 僅開發：連不到公司 LDAP 時用 compose profile dev-ldap 的測試目錄（見 README「登入與團隊」）
DEV_LDAP_ADMIN_PASSWORD=

# 會議紀要模型（OpenAI 相容，整場逐字稿一次送出，需要夠大的 context）
# 沒設定時沿用上面的 TRANSLATE_REFINE_*；要換模型時取消註解填入，再執行 docker compose up -d app
# MINUTES_URL=https://your-llm-gateway/v1
# MINUTES_MODEL=your-large-context-model
# MINUTES_KEY=
